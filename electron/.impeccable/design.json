    },
    {
      "name": "Primary action",
      "kind": "button",
      "description": "Primary action from the implemented desktop shell.",
      "html": "<button class=\"ds-primary\">ลองอีกครั้ง</button>",
      "css": ".ds-primary{font-family:\"Segoe UI\",Arial,\"Noto Sans Thai\",sans-serif;background:var(--accent,#1a5ecb);color:white;border:0;border-radius:5px;padding:10px 20px;cursor:pointer}.ds-primary:focus-visible{outline:2px solid var(--accent,#1a5ecb);outline-offset:2px;}",
      "refersTo": "primary"
    },
    {
      "name": "Text action",
      "kind": "button",
      "description": "Text action from the implemented desktop shell.",
      "html": "<button class=\"ds-text\">นำออก</button>",
      "css": ".ds-text{font-family:\"Segoe UI\",Arial,\"Noto Sans Thai\",sans-serif;border:0;background:transparent;color:var(--accent,#1a5ecb);padding:8px 10px;border-radius:6px;cursor:pointer}.ds-text:hover{background:var(--hover,#e8edf7)}.ds-text:focus-visible{outline:2px solid var(--accent,#1a5ecb);outline-offset:2px;}"
    },
    {
      "name": "Home search",
      "kind": "input",
      "description": "Home search from the implemented desktop shell.",
      "html": "<form class=\"ds-search\"><input aria-label=\"ค้นหาเว็บไซต์\" placeholder=\"ค้นหาด้วย Google หรือป้อน URL\"></form>",
      "css": ".ds-search{width:min(570px,90%);height:48px;border-radius:25px;display:flex;align-items:center;padding:0 18px;box-shadow:0 1px 6px #2021243d;background:var(--surface,#fff)}.ds-search input{font-family:\"Segoe UI\",Arial,\"Noto Sans Thai\",sans-serif;border:0;outline:none;background:transparent;width:100%;color:var(--ink,#202124);font-size:15px}.ds-search input::placeholder{color:var(--muted,#515762)}.ds-search:focus-within{outline:2px solid #2867cf;outline-offset:3px}",
      "refersTo": "home-search"
