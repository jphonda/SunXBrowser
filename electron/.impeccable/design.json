      "name": "Browser tab",
      "kind": "nav",
      "description": "Browser tab from the implemented desktop shell.",
      "html": "<div class=\"ds-strip\"><div class=\"ds-tab\" role=\"tab\" aria-selected=\"true\" tabindex=\"0\">แท็บใหม่</div></div>",
      "css": ".ds-strip{background:var(--strip,#dce6f9);padding:5px 8px 0}.ds-tab{font-family:\"Segoe UI\",Arial,\"Noto Sans Thai\",sans-serif;width:222px;padding:10px 12px;border-radius:11px 11px 0 0;background:var(--surface,#fff);color:var(--ink,#202124);font-size:12px;cursor:pointer;transition:background 120ms ease-out}.ds-tab:focus{outline:2px solid #2867cf;outline-offset:-3px}@media(prefers-reduced-motion:reduce){.ds-tab{transition:none}}",
      "refersTo": "tab"
    }
