      "kind": "button",
      "description": "Icon button from the implemented desktop shell.",
      "html": "<button class=\"ds-icon\" aria-label=\"แท็บใหม่\">+</button>",
      "css": ".ds-icon{font-family:\"Segoe UI\",Arial,\"Noto Sans Thai\",sans-serif;background:transparent;color:var(--ink,#202124);border:0;width:34px;height:34px;border-radius:50%;padding:7px;cursor:pointer}.ds-icon:hover{background:var(--hover,#e8edf7)}.ds-icon:focus-visible{outline:2px solid var(--accent,#1a5ecb);outline-offset:2px;}",
